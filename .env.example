# Deployment configuration. Copy to `.env` (gitignored) and fill in your values.
# Sourced by deploy.sh and read by the local scripts.

# Your Google Cloud project ID.
GCP_PROJECT=your-gcp-project-id

# Region to deploy the Cloud Functions to.
REGION=us-central1

# Runtime service account the functions execute as.
SERVICE_ACCOUNT=gmail-classifier-sa@your-gcp-project-id.iam.gserviceaccount.com

# Pub/Sub topic Gmail publishes notifications to.
PUBSUB_TOPIC=gmail-notifications

# Anthropic model used for classification.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# How many of the most recent inbox messages the classifier scans per Pub/Sub
# notification. Already-labelled messages are skipped, so this is just the
# look-back window for catching bursts that arrive faster than notifications.
# Raise it if you get mail in bursts; higher = more Gmail/Claude calls per run.
MAX_MESSAGES=5
